# ─────────────────────────────────────────────────────────────────────────────
# HR Knowledge Base Assistant — AWS Lambda image
#
# Deliberately separate from the main Dockerfile, which Railway uses and which
# this must not disturb. Three things differ from it:
#   1. An AWS base image, carrying the Runtime Interface Client — what turns an
#      ordinary container into something Lambda knows how to invoke.
#   2. The command is a handler name, not gunicorn.
#   3. The vector store travels inside the image.
#
# A container rather than a zip: Lambda's zip package caps at 250 MB unpacked and
# chromadb with its dependencies does not fit. An image goes up to 10 GB.
# ─────────────────────────────────────────────────────────────────────────────

FROM public.ecr.aws/lambda/python:3.12

# ── System dependencies ──────────────────────────────────────────────────────
# file-libs = libmagic, needed by python-magic for file type detection
# libgomp   = OpenMP, used by onnxruntime (a chromadb dependency)
RUN dnf install -y file-libs libgomp && dnf clean all

# ── Python dependencies ──────────────────────────────────────────────────────
# LAMBDA_TASK_ROOT is /var/task, where Lambda looks for the code.
COPY requirements-prod.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-prod.txt

# ── Application source ───────────────────────────────────────────────────────
COPY app/          ${LAMBDA_TASK_ROOT}/app/
COPY evaluation/   ${LAMBDA_TASK_ROOT}/evaluation/
COPY vector_store/ ${LAMBDA_TASK_ROOT}/vector_store/
COPY config.py observability.py lambda_handler.py ${LAMBDA_TASK_ROOT}/
# The HR analytics database is read-only reference data — sql_tool allows only
# SELECT/WITH — so it travels inside the image. The transactional database
# (users, sessions, messages) lives in RDS because it needs to write.
COPY hr_data.db ${LAMBDA_TASK_ROOT}/

# ── Environment ──────────────────────────────────────────────────────────────
# MODEL_NAME is declared rather than inherited from the config.py default. That
# default is "gpt-4o", which the factory maps to Claude Sonnet 4.6, and with
# three to four sequential calls a cold request took 35 s: API Gateway cut at 29
# and returned 503. With Haiku the same chain runs 8-10 s warm and 17 s cold.
#
# The config.py default is written for Railway, where there is no request
# ceiling. Here there is one, so the model choice is stated explicitly.
# The vector store is read from the image: it is read-only and never re-ingested
# on Lambda. persist_bm25_index() writes to disk and therefore CANNOT run here;
# load_bm25_index() only reads, and can.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UP_VECTOR_STORE_PATH=/var/task/vector_store/info \
    HR_DB_URI=sqlite:////var/task/hr_data.db \
    LLM_PROVIDER=bedrock \
    MODEL_NAME=gpt-4o-mini \
    HOME=/tmp

# ── Handler ──────────────────────────────────────────────────────────────────
# "module.attribute": lambda_handler.py, the `handler` variable.
CMD ["lambda_handler.handler"]
