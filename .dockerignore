.env
*.db
# ...except the HR analytics database: read-only reference data (sql_tool allows
# only SELECT/WITH), so it travels baked into the image like the vector store.
# The transactional database — users, sessions, messages — lives in RDS, which is
# the one that needs to write.
!hr_data.db
__pycache__/
*.pyc
*.pyo
.git/
.gitignore
instance/

# Local virtualenvs: a full copy of Python that never runs inside the container,
# since the image installs its dependencies into /usr/local. Measured at 906 MB
# of the image. On Lambda, size is cold-start time.
.venv/
venv/
env/

# Development artefacts
.pytest_cache/
.github/
*.log
.vscode/
.idea/
